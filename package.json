{
  "name": "intellipath",
  "version": "1.0.0",
  "description": "IntelliPath — Smart Operations Platform (React + Vite + Tailwind, Express + SQLite)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
